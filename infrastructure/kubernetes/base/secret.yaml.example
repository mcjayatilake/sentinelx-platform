# Template for the Secret that supplies sensitive configuration.
#
# Do NOT commit a real secret.yaml. Generate one per environment from a
# secret manager (e.g. `kubectl create secret generic ... --from-env-file`)
# or via a GitOps secrets tool (Sealed Secrets, External Secrets Operator,
# SOPS). This file exists only to document the required keys.

apiVersion: v1
kind: Secret
metadata:
  name: sentinelx-secrets
  labels:
    app.kubernetes.io/part-of: sentinelx
type: Opaque
stringData:
  DATABASE_URL: "postgresql+asyncpg://<user>:<password>@<host>:5432/sentinelx"
  DATABASE_URL_SYNC: "postgresql+psycopg://<user>:<password>@<host>:5432/sentinelx"
  REDIS_URL: "redis://<host>:6379/0"
  CELERY_BROKER_URL: "redis://<host>:6379/1"
  CELERY_RESULT_BACKEND: "redis://<host>:6379/2"
  JWT_SECRET_KEY: "<generate-a-random-64-byte-secret>"
  OAUTH2_GOOGLE_CLIENT_ID: ""
  OAUTH2_GOOGLE_CLIENT_SECRET: ""
  OAUTH2_GITHUB_CLIENT_ID: ""
  OAUTH2_GITHUB_CLIENT_SECRET: ""
  S3_ENDPOINT_URL: "https://<s3-endpoint>"
  S3_ACCESS_KEY_ID: "<access-key>"
  S3_SECRET_ACCESS_KEY: "<secret-key>"
  SENTRY_DSN: ""
