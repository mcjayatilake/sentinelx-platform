# =============================================================================
# SentinelX — Environment Configuration Template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
ENVIRONMENT=local                # local | development | staging | production
DEBUG=true
PROJECT_NAME=SentinelX
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                  # json | console

# -----------------------------------------------------------------------------
# Backend / API
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinelx
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+asyncpg://sentinelx:change-me-in-production@postgres:5432/sentinelx
DATABASE_URL_SYNC=postgresql+psycopg://sentinelx:change-me-in-production@postgres:5432/sentinelx
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# Redis (cache + Celery broker/result backend)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# -----------------------------------------------------------------------------
# Authentication — JWT / OAuth2 / Refresh Tokens
# -----------------------------------------------------------------------------
# Access and refresh tokens are signed with independent secrets — generate
# two distinct random values, never reuse one for both.
JWT_SECRET_KEY=change-me-to-a-random-64-byte-secret
JWT_REFRESH_SECRET_KEY=change-me-to-a-different-random-64-byte-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_KEY_ID=sentinelx-access-1
JWT_REFRESH_KEY_ID=sentinelx-refresh-1
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=sentinelx.io

OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_GITHUB_CLIENT_ID=
OAUTH2_GITHUB_CLIENT_SECRET=
OAUTH2_REDIRECT_URL=http://localhost:3000/auth/callback

# -----------------------------------------------------------------------------
# Password policy / Argon2id
# -----------------------------------------------------------------------------
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=true

# OWASP-baseline Argon2id parameters; tune per deployment's hardware.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# -----------------------------------------------------------------------------
# Email verification / password reset tokens
# -----------------------------------------------------------------------------
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Rate limiting — auth-sensitive endpoints (requests per 60s window per client)
# -----------------------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REFRESH_PER_MINUTE=10
RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=3
RATE_LIMIT_API_KEY_CREATE_PER_MINUTE=5

# -----------------------------------------------------------------------------
# Security response headers
# -----------------------------------------------------------------------------
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_MAX_AGE_SECONDS=63072000
SECURITY_CSP_POLICY=default-src 'self'

# -----------------------------------------------------------------------------
# S3-Compatible Object Storage (MinIO locally, AWS S3 / GCS / R2 in production)
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=sentinelx
S3_SECRET_ACCESS_KEY=change-me-in-production
S3_BUCKET_NAME=sentinelx-artifacts
S3_USE_SSL=false

# -----------------------------------------------------------------------------
# Scan Engine — orchestration defaults (app.scan_engine)
# -----------------------------------------------------------------------------
SCAN_DEFAULT_TIMEOUT_SECONDS=1800
SCAN_DEFAULT_MAX_ATTEMPTS=3
SCAN_RETRY_BACKOFF_BASE_SECONDS=5.0
SCAN_RETRY_BACKOFF_MAX_SECONDS=300.0
SCAN_CONFIG_MAX_BYTES=16384
SCAN_EVENT_METADATA_MAX_BYTES=8192
SCAN_QUEUE_NAME=scans
SCAN_DEAD_LETTER_QUEUE_NAME=scans.dead_letter

# Scan artifact storage — "local" today; a future S3-compatible backend
# reuses the S3-Compatible Object Storage settings above.
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_LOCAL_PATH=./var/scan-artifacts

# -----------------------------------------------------------------------------
# MinIO (local dev object storage service)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=sentinelx
MINIO_ROOT_PASSWORD=change-me-in-production
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000

# -----------------------------------------------------------------------------
# Container Runtime / Scanning Sandboxes
# -----------------------------------------------------------------------------
DOCKER_HOST=unix:///var/run/docker.sock
SCAN_SANDBOX_NETWORK=sentinelx-scan-net
SCAN_SANDBOX_CPU_LIMIT=1.0
SCAN_SANDBOX_MEMORY_LIMIT=1g

# -----------------------------------------------------------------------------
# Frontend (Next.js) — public values only, never put secrets here
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_NAME=SentinelX

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
FLOWER_BASIC_AUTH=admin:change-me

# -----------------------------------------------------------------------------
# Rate Limiting / Security
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
SESSION_SECRET=change-me-to-a-random-64-byte-secret
ALLOWED_HOSTS=["localhost","127.0.0.1"]
